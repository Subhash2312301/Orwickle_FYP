{
  "name": "orwickle-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Orwickle REST API (Node.js + Express + PostgreSQL on Supabase)",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "create-admin": "node --env-file=.env scripts/create-admin.js",
    "approve": "node --env-file=.env scripts/approve.js",
    "test": "node --env-file=.env --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}

# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# Supabase → Connect → Session pooler URI, with the database password (no [ ] brackets)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Allowed browser origins for the admin dashboard, comma-separated (* = any, fine for development)
CORS_ORIGIN=*

# Signs login tokens. At least 32 random characters, the SAME on every laptop/server.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Gmail account that sends OTP emails. SMTP_PASS is a Google "App password" (16 letters), not the Gmail password.
# Leave empty in development to print OTP emails in the console instead.
SMTP_USER=
SMTP_PASS=
# Optional, defaults to "Orwickle <SMTP_USER>"
# MAIL_FROM=Orwickle <orwickle.app@gmail.com>

# Supabase Storage for profile photos and listing images (private bucket, signed links).
# Supabase → Project Settings → API: Project URL and the service_role key (secret! server only).
# Leave empty in development to keep files in backend/uploads instead.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# STORAGE_BUCKET=private-files
